<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="debug">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.grpc.netty.shaded.io.grpc.netty.NettyClientHandler" level="WARN"/>
    <logger name="com.github.jknack.handlebars.internal.HbsParserFactory" level="WARN"/>
    <logger name="io.swagger.codegen.v3.generators.DefaultCodegenConfig" level="WARN"/>
</configuration>
