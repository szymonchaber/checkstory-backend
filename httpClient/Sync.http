< {%
    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0
            var v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    client.global.set("template_id", generateUUID());
    request.variables.set("template_task_1_id", generateUUID());
    request.variables.set("template_task_2_id", generateUUID());
    request.variables.set("template_task_3_id", generateUUID());
    client.global.set("checklist_id", generateUUID());
    request.variables.set("task_1_id", generateUUID());
    request.variables.set("task_2_id", generateUUID());
    request.variables.set("task_3_id", generateUUID());
%}
POST {{endpoint}}/sync/commands
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

{
  "checklistCommands": [],
  "templateCommands": [
    {
      "type": "createTemplate",
      "templateId": "{{template_id}}",
      "commandId": "{{$uuid}}",
      "timestamp": "{{$isoTimestamp}}",
      "existingTemplateData": {
        "title": "Existing title",
        "description": "Existing description",
        "tasks": [
          {
          "id": "{{task_2_id}}",
          "parentId": null,
          "title": "Task 2",
          "children": [
            {
              "id": "{{task_3_id}}",
              "parentId": "{{task_1_id}}",
              "title": "Task 3 - deleted later",
              "children": [
              ],
              "sortPosition": 0
            }
          ],
          "sortPosition": 0
        },
        {
          "id": "{{task_1_id}}",
          "parentId": null,
          "title": "Task 1",
          "children": [
          ],
          "sortPosition": 1
        }
      ],
      "reminders": [
        {
          "type": "exact",
          "id": "{{$uuid}}",
          "forTemplate": "{{template_id}}",
          "startDateTime": "2023-06-06T03:14:00.036"
        },
        {
          "type": "recurring",
          "id": "{{$uuid}}",
          "forTemplate": "{{template_id}}",
          "startDateTime": "2023-06-06T03:14:00.159",
          "interval": {
            "type": "daily"
          }
        },
        {
          "type": "recurring",
          "id": "{{$uuid}}",
          "forTemplate": "{{template_id}}",
          "startDateTime": "2023-06-06T03:14:00.468",
          "interval": {
            "type": "weekly",
            "dayOfWeek": "TUESDAY"
          }
        },
        {
          "type": "recurring",
          "id": "{{$uuid}}",
          "forTemplate": "{{template_id}}",
          "startDateTime": "2023-06-06T03:14:00.611",
          "interval": {
            "type": "monthly",
            "dayOfMonth": 1
          }
        },
        {
          "type": "recurring",
          "id": "{{$uuid}}",
          "forTemplate": "{{template_id}}",
          "startDateTime": "2023-06-06T03:15:00.243",
          "interval": {
            "type": "yearly",
            "dayOfYear": 1
          }
        }
      ]
      }
    }
  ]
}


