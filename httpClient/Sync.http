    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0,
                v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    client.global.set("template_id", generateUUID());
    request.variables.set("template_task_1_id", generateUUID());
    request.variables.set("template_task_2_id", generateUUID());
    request.variables.set("template_task_3_id", generateUUID());
%}
