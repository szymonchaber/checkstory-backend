### Register user 1
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}
Content-Type: application/json

{
  "email": "{{login_1}}",
  "password": "{{password_1}}",
  "returnSecureToken": true
}

> {%
    client.global.set("auth_token_1", response.body.idToken);
    client.global.set("user_id_1", response.body.localId);
%}

### Register user 2
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}
Content-Type: application/json

{
  "email": "{{login_2}}",
  "password": "{{password_2}}",
  "returnSecureToken": true
}

> {%
    client.global.set("auth_token_2", response.body.idToken);
    client.global.set("user_id_2", response.body.localId);
%}

### Get all checklists of user 1
GET http://0.0.0.0:8080/checklists
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

### Get concrete checklist
GET http://0.0.0.0:8080/checklists/{{checklist_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

<> 2023-04-19T021349.200.json
<> 2023-04-19T015343.200.json
<> 2023-04-19T015331.200.json
<> 2023-04-19T015306.200.json

###
GET http://0.0.0.0:8080/checklists/{{checklist_id}}/tasks
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}


### Send all commands as user 1
< {%
    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0,
                v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    client.global.set("checklist_id", generateUUID());
    request.variables.set("task_1_id", generateUUID());
    request.variables.set("task_2_id", generateUUID());
    request.variables.set("task_3_id", generateUUID());
%}
POST http://0.0.0.0:8080/checklist-commands
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

[
    {
    "type": "createChecklist",
    "templateId": "{{template_id}}",
    "title": "All the events",
    "description": "Description",
    "tasks": [
     {
        "id": "{{task_1_id}}",
        "checklistId": {{checklist_id}},
        "title": "Task 1",
        "sortPosition": 0,
        "isChecked": false,
        "children": [
          {
            "id": "{{task_2_id}}",
            "checklistId": "{{checklist_id}}",
            "title": "Task 2",
            "sortPosition": 0,
            "isChecked":  false,
            "children": []
          }
          ]
    }
    ],
    "checklistId": "{{checklist_id}}",
    "commandId": "{{$uuid}}",
    "timestamp": "{{$isoTimestamp}}"
  },
  {
    "type": "editChecklistNotes",
    "newNotes": "My notes are awesome",
    "checklistId": "{{checklist_id}}",
    "commandId": "{{$uuid}}",
    "timestamp": "{{$isoTimestamp}}"
  },
    {
    "type": "changeTaskChecked",
    "taskId": "{{task_1_id}}",
    "isChecked": true,
    "checklistId": "{{checklist_id}}",
    "commandId": "{{$uuid}}",
    "timestamp": "{{$isoTimestamp}}"
  },
   {
    "type": "changeTaskChecked",
    "taskId": "{{task_2_id}}",
    "isChecked": true,
    "checklistId": "{{checklist_id}}",
    "commandId": "{{$uuid}}",
    "timestamp": "{{$isoTimestamp}}"
  }
]