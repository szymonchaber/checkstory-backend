### Register user 1 in Firebase
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}
Content-Type: application/json

{
  "email": "{{login_1}}",
  "password": "{{password_1}}",
  "returnSecureToken": true
}

> {%
    client.global.set("auth_token_1", response.body.idToken);
    client.global.set("user_id_1", response.body.localId);
%}

### Register user 2
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}
Content-Type: application/json

{
  "email": "{{login_2}}",
  "password": "{{password_2}}",
  "returnSecureToken": true
}

> {%
    client.global.set("auth_token_2", response.body.idToken);
    client.global.set("user_id_2", response.body.localId);
%}


### Register user 1 in the backend
POST {{endpoint}}/auth/register
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

{
}

### Register user 2 in the backend
POST {{endpoint}}/auth/register
Content-Type: application/json
Authorization: Bearer {{auth_token_2}}

{
}

### Post a purchase token for the user 1
POST {{endpoint}}/payment/google-play-token
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

{
  "token": "{{active_purchase_token}}"
}

### Post the same purchase token for the user 2 - expect 409
POST {{endpoint}}/payment/google-play-token
Content-Type: application/json
Authorization: Bearer {{auth_token_2}}

{
  "token": "{{active_purchase_token}}"
}

### Post Firebase messaging token
POST {{endpoint}}/notification/firebase-token
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

{
  "token": "{{active_messaging_token}}"
}

### Login
GET {{endpoint}}/auth/login
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

### Get all templates of user 1
GET {{endpoint}}/templates
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

### Get concrete template
GET {{endpoint}}/templates/9fedb356-58f8-4466-b966-6efbe3b2a16f
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

<> 2023-04-19T021349.200.json
<> 2023-04-19T015343.200.json
<> 2023-04-19T015331.200.json
<> 2023-04-19T015306.200.json

### Send all commands as user 1
< {%
    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0,
                v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    client.global.set("template_id", generateUUID());
    request.variables.set("task_1_id", generateUUID());
    request.variables.set("task_2_id", generateUUID());
    request.variables.set("task_3_id", generateUUID());
%}
POST {{endpoint}}/commands
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

[
