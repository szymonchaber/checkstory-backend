### Send all commands as user 1
< {%
    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0,
                v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    request.variables.set("template_id", generateUUID());
    request.variables.set("task_1_id", generateUUID());
    request.variables.set("task_2_id", generateUUID());
    request.variables.set("task_3_id", generateUUID());
%}
POST http://0.0.0.0:8080/commands
Content-Type: application/json
Authorization: Bearer {{auth_token_1}}

[
{
    "type": "createTemplate",
    "templateId": "{{template_id}}",
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
    "type": "addTemplateTask",
    "templateId": "{{template_id}}",
    "taskId": "{{task_3_id}}",
    "parentTaskId": null,
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
    "type": "editTemplateTitle",
    "templateId": "{{template_id}}",
    "newTitle": "All the events",
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
    "type": "addTemplateTask",
    "templateId": "{{template_id}}",
    "taskId": "{{task_1_id}}",
    "parentTaskId": null,
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
    "type": "renameTemplateTask",
    "templateId": "{{template_id}}",
    "taskId": "{{task_3_id}}",
    "newTitle": "Task 3 - deleted later",
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
    "type": "renameTemplateTask",
    "templateId": "{{template_id}}",
    "taskId": "{{task_1_id}}",
    "newTitle": "Task 1",
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
    "type": "editTemplateDescription",
    "templateId": "{{template_id}}",
    "newDescription": "Description",
    "eventId": "{{$uuid}}",
    "timestamp": {{$timestamp}},
    "userId": "{{user_id_1}}"
  },
  {
